# Built output — always rebuilt from the sources with `mise run build`
out/
# Tooling
.venv/
__pycache__/
# The working database — the seed files are the data; the working copy is never committed
.work/
*.db
*.db-journal
*.db-wal
*.db-shm
# Cloudflare's tools' local files: wrangler's state and caches, cf's account cache — never committed
.wrangler/
.cloudflare/
# Go test caches and editor files
*.test
*.out
.DS_Store
# Installed packages
node_modules/
# mise's override for one machine: mise-check's own checkout pins its build there (local)
.mise/config.local.toml
